{
  "name": "findcarbr",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:api:dev\" \"vite\"",
    "web": "vite",
    "api": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "api:dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch-path=server server/index.js",
    "build": "vite build",
    "start": "npm run build && node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.js\"",
    "db:validar": "node server/scripts/validar.js",
    "db:popular": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/scripts/popular.js",
    "db:fipe": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/scripts/importar-fipe.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
