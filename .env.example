# Copie para .env e preencha. O .env nunca vai para o Git.

# Porta da API (o Vite encaminha /api para cá em desenvolvimento)
PORT=3001

# Opcional: análise por IA (Google Gemini) — https://aistudio.google.com/apikey
# Deixe vazio para manter a IA desativada (as seções de IA somem do site).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcional: token gratuito de https://fipe.online aumenta o limite diário da importação FIPE
FIPE_TOKEN=

# Opcional: caminho do banco (padrão: server/data/findcar.db)
# DB_PATH=
